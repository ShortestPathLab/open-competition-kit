{
  "name": "open-competition-kit",
  "private": false,
  "scripts": {
    "tsc:all": "bash ./tsc.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:prisma:generate": "bun packages/packages/db/prisma/generate.ts",
    "db:prisma:studio": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres bunx prisma studio --config packages/packages/db/prisma/prisma.config.ts",
    "db:prisma:reset": "bunx prisma migrate reset --schema packages/packages/db/prisma/schemas/schema.prisma --config packages/packages/db/prisma/prisma.config.ts"
  },
  "workspaces": [
    "packages/**"
  ],
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  }
}
